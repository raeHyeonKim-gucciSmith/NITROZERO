    <Style src="project://database/Assets/04HYUNWOOK/UI%20Toolkit/RacingHUD/CleanHUD.uss?fileID=7433441132597879392&amp;guid=97a185a2a06c49d482285e1d62273b8e&amp;type=3#CleanHUD"/>
    <ui:VisualElement name="racing-hud" picking-mode="Position" class="hud photo-hud tps-document clean-hud" style="top: 0; bottom: 1px; right: 0; left: 0;">
        <ui:VisualElement name="tps-scale-title" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; width: 100%; height: 100%; scale: 1.08 1.08; transform-origin: 0% 0%;">
            <racing:HudVectorPart name="art-title-frame" path-data="M 20 37 L 35 23 L 294 23 L 245 74 L 28 74 L 20 66 Z" view-width="435" view-height="132" stroke-width="2.5" stroke-color="#FF1010FF" fill-color="#18222DFF" picking-mode="Position" class="artwork-part" style="position: absolute; left: 0%; top: 0%; width: 26.01675%; height: 14.02763%;"/>
            <ui:Label text="TEAM RED / X-01" name="theme-title" picking-mode="Position" class="theme-title" style="top: 38px; left: 50px; width: 221px; -unity-text-align: upper-center; font-size: 18px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="tps-scale-timer" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; width: 100%; height: 100%; scale: 1.08 1.08; transform-origin: 50% 0%;">
            <racing:HudVectorPart name="art-timer-frame" path-data="M 112 20 L 483 20 L 404 100 L 114 100 L 79 65 L 35 65 L 42 55 L 78 55 Z" view-width="535" view-height="132" stroke-width="2.5" stroke-color="#FF1010FF" fill-color="#18222DFF" picking-mode="Position" class="artwork-part" style="position: absolute; left: 33.97129%; top: 0%; width: 31.99761%; height: 14.02763%;"/>
            <ui:VisualElement name="timer-panel" picking-mode="Position" class="timer panel">
                <ui:Label text="TIME" name="caption" picking-mode="Position" class="caption"/>
                <racing:DigitalReadout name="time-value" text="00:00.000" picking-mode="Position" fit-to-bounds="true" optical-center="true" class="time digital" style="top: 24px; left: 64px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="tps-scale-map" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; width: 100%; height: 100%; scale: 1.08 1.08; transform-origin: 0% 100%;">
            <racing:HudVectorPart name="art-map-frame" path-data="M 23 39 L 37 22 L 162 22 L 174 29 L 222 29 L 236 43 L 236 397 L 221 409 L 37 409 L 23 395 Z" view-width="385" view-height="423" stroke-width="2.5" stroke-color="#FF1010FF" fill-color="#000000FF" picking-mode="Position" class="map-artwork" style="position: absolute; left: 0%; top: 55.04782%; width: 23.02632%; height: 44.95218%;"/>
            <ui:VisualElement name="minimap-panel" picking-mode="Position" class="minimap panel">
                <ui:Label text="ROUTE MAP" name="caption-3" picking-mode="Position" class="caption" style="position: absolute; left: 18.6px; top: 13.6px; width: 186px; height: 24px; font-size: 16px; margin: 0; padding: 0; border-width: 0; -unity-text-align: middle-left;"/>
                <ui:VisualElement name="map-viewport" picking-mode="Position" class="map-viewport">
                    <racing:NavigationMap map-tint="#000000FF" name="navigation-road" road-width="0.55" horizon="0.22" haze="1" picking-mode="Position" class="navigation-road"/>
                </ui:VisualElement>
                <ui:Label name="route-distance" text="DISTANCE LEFT" picking-mode="Position" class="route-distance" style="position: absolute; left: 5.263162%; top: 97.47904%; right: auto; bottom: auto; width: 83.73207%; height: 9.151022%; margin: 0; padding: 0; font-size: 14px; -unity-text-align: middle-center; overflow: hidden;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="tps-scale-ranking" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; width: 100%; height: 100%; scale: 1.08 1.08; transform-origin: 100% 0%;">
            <ui:VisualElement name="ranking-panel" picking-mode="Position" class="ranking panel" style="top: 10%;">
                <racing:HudVectorPart name="group-art" path-data="M 18 18 L 31 5 L 181 5 L 192 12 L 389 12 L 404 28 L 404 181 L 392 193 L 33 193 L 18 178 Z" view-width="409" view-height="198" stroke-width="2.5" stroke-color="#FF1010FF" fill-color="#18222DFF" picking-mode="Position" class="group-art ranking-art"/>
                <ui:VisualElement name="ranking-content" picking-mode="Ignore" class="ranking-content">
                    <ui:Label text="POSITION" name="caption-2" picking-mode="Position" class="caption"/>
                    <ui:Label text="PROGRESS" name="ranking-progress-caption" picking-mode="Position" class="ranking-progress-caption"/>
                    <ui:VisualElement name="ranking-row-1" picking-mode="Position" class="ranking-row ranking-player">
                        <ui:Label text="01" name="rank-pos" picking-mode="Position" class="rank-pos ranking-cell" style="align-self: center; -unity-text-align: upper-center;"/>
                        <ui:Label text=" PLAYER" name="rank-driver" picking-mode="Position" class="rank-driver ranking-cell"/>
                        <ui:Label text="0%" name="rank-time" picking-mode="Position" class="rank-time ranking-cell"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="ranking-row-2" picking-mode="Position" class="ranking-row">
                        <ui:Label text="02" name="rank-pos-2" picking-mode="Position" class="rank-pos ranking-cell" style="-unity-text-align: upper-center;"/>
                        <ui:Label text=" ---" name="rank-driver-2" picking-mode="Position" class="rank-driver ranking-cell"/>
                        <ui:Label text="--%" name="rank-time-2" picking-mode="Position" class="rank-time ranking-cell"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="ranking-row-3" picking-mode="Position" class="ranking-row">
                        <ui:Label text="03" name="rank-pos-3" picking-mode="Position" class="rank-pos ranking-cell" style="-unity-text-align: upper-center;"/>
                        <ui:Label text=" ---" name="rank-driver-3" picking-mode="Position" class="rank-driver ranking-cell"/>
                        <ui:Label text="--%" name="rank-time-3" picking-mode="Position" class="rank-time ranking-cell"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="tps-scale-instrument" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; width: 100%; height: 100%; scale: 1.08 1.08; transform-origin: 100% 100%;">
