                <ui:Label text="km/h" name="unit" picking-mode="Position" class="unit" style="position: absolute; left: 78.68806%; top: 34.38198%; width: 13.81131%; height: 15.44462%; margin: 0; padding: 0; overflow: hidden; font-size: 14.81481px; -unity-text-align: middle-center;"/>
