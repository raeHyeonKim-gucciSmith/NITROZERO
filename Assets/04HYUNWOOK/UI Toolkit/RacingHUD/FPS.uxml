            <racing:HudVectorPart name="indicator-brake" tooltip="Brake system — unlit" path-data="M 43 20 C 43 28.3 36.3 35 28 35 C 19.7 35 13 28.3 13 20 C 13 11.7 19.7 5 28 5 C 36.3 5 43 11.7 43 20 Z M 10 5 C 0 12 0 28 10 35 M 46 5 C 56 12 56 28 46 35 M 28 11 L 28 23 M 28 27 L 28 29" view-width="56" view-height="40" stroke-width="1.7" stroke-color="#94A1A86B" fill-color="#00000000" picking-mode="Position" class="vehicle-indicator" style="position: absolute; left: 18px; top: 166.5px; rotate: 3deg; transform-origin: 50% 50%;"/>
            <ui:VisualElement name="indicator-abs" tooltip="ABS — unlit" picking-mode="Position" class="vehicle-indicator" style="position: absolute; left: 0; top: 222px; rotate: 6deg; transform-origin: 50% 50%;">
                <racing:HudVectorPart name="indicator-abs-outline" path-data="M 45 20 C 45 29 37 36 28 36 C 19 36 11 29 11 20 C 11 11 19 4 28 4 C 37 4 45 11 45 20 Z M 7 4 C -1 13 -1 27 7 36 M 49 4 C 57 13 57 27 49 36" view-width="56" view-height="40" stroke-width="1.7" stroke-color="#94A1A86B" fill-color="#00000000" picking-mode="Position" class="indicator-abs-outline"/>
