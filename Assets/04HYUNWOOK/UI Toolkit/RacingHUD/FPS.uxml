                <racing:DigitalReadout name="fuel-percent" text="100" fit-to-bounds="true" picking-mode="Position" optical-center="true" class="side-fuel-percent digital"/>
                <ui:Label text="%" name="side-fuel-unit" picking-mode="Position" class="side-fuel-unit"/>
            </ui:VisualElement>
            <ui:VisualElement name="side-fuel-litres-row" picking-mode="Position" class="side-fuel-litres-row">
                <racing:DigitalReadout name="fuel-value" text="60" fit-to-bounds="true" picking-mode="Position" optical-center="true" class="side-fuel-litres digital"/>
                <ui:Label text="/" name="side-fuel-slash" picking-mode="Position" class="side-fuel-slash"/>
                <racing:DigitalReadout name="fuel-capacity" text="60" fit-to-bounds="true" picking-mode="Position" optical-center="true" class="side-fuel-litres digital"/>
                <ui:Label text="L" name="side-fuel-litre-unit" picking-mode="Position" class="side-fuel-litre-unit"/>
            </ui:VisualElement>
            <ui:VisualElement name="side-fuel-rail" picking-mode="Position" class="side-fuel-rail">
                <ui:VisualElement name="fuel-fill" picking-mode="Position" class="side-fuel-fill"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="side-coolant-panel" picking-mode="Position" class="side-fuel-panel side-coolant-panel">
