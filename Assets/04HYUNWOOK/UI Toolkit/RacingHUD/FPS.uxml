            <ui:VisualElement name="ranking-row-3" picking-mode="Position" class="ranking-row" style="position: absolute; left: 16px; top: 136px; width: 288px; height: 43px; border-width: 0; overflow: hidden;">
                <ui:Label text="03" name="rank-pos-3" picking-mode="Position" class="rank-pos ranking-cell" style="position: absolute; left: 0; top: 0; width: 34px; height: 100%; margin: 0; padding: 0; font-size: 25px; -unity-text-align: middle-center; color: rgb(218, 225, 230);"/>
                <ui:Label text="---" name="rank-driver-3" picking-mode="Position" class="rank-driver ranking-cell" style="position: absolute; left: 43px; top: 0; width: 154px; height: 100%; margin: 0; padding: 0; font-size: 19px; -unity-text-align: middle-left;"/>
                <ui:Label text="--%" name="rank-time-3" picking-mode="Position" class="rank-time ranking-cell" style="position: absolute; left: 202px; top: 0; width: 86px; height: 100%; margin: 0; padding: 0; font-size: 24px; -unity-text-align: middle-right;"/>
