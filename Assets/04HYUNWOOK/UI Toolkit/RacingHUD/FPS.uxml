            <racing:DigitalReadout name="coolant-tick-40" text="40" fit-to-bounds="true" optical-center="true" picking-mode="Position" class="coolant-intermediate-tick digital" style="left: 62.96px; top: 185.2px;"/>
            <racing:DigitalReadout name="coolant-tick-20" text="20" fit-to-bounds="true" optical-center="true" picking-mode="Position" class="coolant-intermediate-tick digital" style="left: 70.64px; top: 229.6px;"/>
            <racing:DigitalReadout name="coolant-normal-tick" text="80" fit-to-bounds="true" optical-center="true" picking-mode="Position" class="coolant-normal-tick digital" style="translate: 0 0%;"/>
            <racing:DigitalReadout text="0" fit-to-bounds="true" optical-center="true" name="coolant-cold-label" picking-mode="Position" class="coolant-end-label coolant-cold-label" style="translate: 0 0%;"/>
