                <racing:DigitalReadout name="coolant-value" text="80" fit-to-bounds="true" optical-center="true" picking-mode="Position" class="side-fuel-percent side-coolant-value digital"/>
                <ui:Label text="°C" name="coolant-unit" picking-mode="Position" class="side-fuel-unit side-coolant-unit"/>
            </ui:VisualElement>
            <ui:Label text="80°C REF" name="side-coolant-reference" picking-mode="Position" class="side-coolant-reference"/>
            <ui:VisualElement name="side-coolant-rail" picking-mode="Position" class="side-fuel-rail side-coolant-rail">
                <ui:VisualElement name="coolant-fill" picking-mode="Position" class="side-fuel-fill side-coolant-fill"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="coolant-panel" picking-mode="Position" class="coolant-panel" style="translate: -75px 0%;">
            <racing:HudVectorPart name="coolant-symbol" path-data="M 13 18 L 13 5 C 13 1 19 1 19 5 L 19 18 C 27 25 20 34 15 30 C 9 30 7 23 13 18 Z M 19 7 L 25 7 M 19 12 L 23 12 M 3 33 C 7 29 9 37 13 33 M 18 33 C 22 29 25 37 30 33" view-width="34" view-height="38" stroke-width="1.5" stroke-color="#D4E0E6CC" fill-color="#00000000" picking-mode="Position" class="coolant-symbol" style="translate: 0 0%;"/>
            <ui:Label text="TEMP °C" name="coolant-title" picking-mode="Position" class="coolant-title" style="translate: 0 0%;"/>
            <racing:DigitalReadout text="100" fit-to-bounds="true" optical-center="true" name="coolant-hot-label" picking-mode="Position" class="coolant-end-label coolant-hot-label" style="translate: 0 0%;"/>
            <ui:VisualElement name="coolant-gauge-track" picking-mode="Position" class="coolant-gauge-track" style="translate: 0 0%;">
                <racing:HudVectorPart name="coolant-gauge-rail" path-data="M 62 0 C 30 74 30 148 62 222 M 55.575 -2.778 L 68.425 2.778 M 49.580 20.892 L 57.140 23.508 M 39.864 42.642 L 53.416 46.158 M 37.899 65.918 L 45.781 67.282 M 31.986 88.197 L 45.934 89.403 M 34.000 111.000 L 42.000 111.000 M 31.986 133.803 L 45.934 132.597 M 37.899 156.082 L 45.781 154.718 M 39.864 179.358 L 53.416 175.842 M 49.580 201.108 L 57.140 198.492 M 55.575 224.778 L 68.425 219.222" view-width="90" view-height="222" stroke-width="1.3" stroke-color="#C0CFD780" fill-color="#00000000" picking-mode="Position" class="coolant-track-art"/>
                <racing:HudVectorPart name="coolant-normal-range" path-data="M 53.36 22.2 C 48.24 37 44.4 51.8 41.84 66.6" view-width="90" view-height="222" stroke-width="3" stroke-color="#D4E0E6B3" fill-color="#00000000" picking-mode="Position" class="coolant-track-art"/>
                <racing:HudVectorPart name="coolant-hot-range" path-data="M 62 0 C 58.8 7.4 55.92 14.8 53.36 22.2" view-width="90" view-height="222" stroke-width="3" stroke-color="#FF3434A6" fill-color="#00000000" picking-mode="Position" class="coolant-track-art"/>
                <racing:HudVectorPart name="coolant-needle" path-data="M 1 7 L 18 1 L 18 13 Z" view-width="20" view-height="14" stroke-width="0" stroke-color="#00000000" fill-color="#FF3434FF" picking-mode="Position" class="coolant-needle"/>
