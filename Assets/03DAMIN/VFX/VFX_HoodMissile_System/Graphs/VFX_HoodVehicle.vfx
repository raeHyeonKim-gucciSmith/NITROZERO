  stickyNoteInfos:
  - title: Hood Missile / usage
    position:
      serializedVersion: 2
      x: -1000
      y: -550
      width: 660
      height: 450
    contents: 'VEHICLE: one graph / five native systems. Interior + left/right pressure
      leaks + Launch smoke/flash. Controller updates level envelopes and local Transform
      references. Launch event fires once. No Custom HLSL. Preview graph alone: set
      InteriorLevel and SideLevelLeft/Right above zero.'
    theme: Classic
    textSize: Medium
    colorTheme: 0
