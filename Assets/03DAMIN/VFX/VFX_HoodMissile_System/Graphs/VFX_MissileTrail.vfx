  stickyNoteInfos:
  - title: Hood Missile / usage
    position:
      serializedVersion: 2
      x: -1000
      y: -550
      width: 660
      height: 450
    contents: 'MISSILE: LOCAL hot core attached tightly to exhaust + WORLD lit smoke.
      EmitterPosition is read in smoke Initialize only. Released smoke remains in
      space after missile moves. Lifetime approximately TrailLength / (MissileSpeed
      + TrailSpeed), clamped by MaxSmokeLifetime. Automatic bounds support moving
      emitter. No Custom HLSL.'
    theme: Classic
    textSize: Medium
    colorTheme: 0
  categories: []
  uiBounds:
    serializedVersion: 2
    x: 0
    y: 0
    width: 0
    height: 0
