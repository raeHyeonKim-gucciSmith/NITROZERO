  stickyNoteInfos:
  - title: Hood Missile / usage
    position:
      serializedVersion: 2
      x: -1000
      y: -550
      width: 660
      height: 450
    contents: SIDE OVERFLOW ONLY. Continuous spawn with birth alpha; short capped
      sideways leak then rising curl. Neighbouring births share a slowly changing
      flow. AlongVelocity elongated soft flipbook wisps, not round missile plume
      particles. Body proxy retained. FlowTime seconds and SwirlSpeed radians/sec
      are supplied by hood controller. Interior must finish building before side
      rate ramps.
    theme: Classic
    textSize: Medium
    colorTheme: 0
  categories: []
  uiBounds:
    serializedVersion: 2
    x: 0
    y: 0
    width: 0
    height: 0
