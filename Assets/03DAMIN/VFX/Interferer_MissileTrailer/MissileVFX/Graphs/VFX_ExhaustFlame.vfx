  stickyNoteInfos:
  - title: Hood Missile / usage
    position:
      serializedVersion: 2
      x: -1000
      y: -550
      width: 666
      height: 450
    contents: FINAL vehicle missile VFX / Exhaust flame / local. Exposed controls
      are driven by the prefab controller. Emission defaults to zero. LaunchBurst
      uses Launch event. Native editable blocks; pooled smoke collides with moving
      roof + floor planes; overflow collides with a dedicated body proxy box. Smoke
      trail uses World simulation and reads emitter position only at Initialize.
      No global rendering changes.
    theme: Classic
    textSize: Medium
    colorTheme: 1
  categories: []
  uiBounds:
    serializedVersion: 2
    x: -1000
    y: -550
    width: 2133
    height: 5295
