  stickyNoteInfos:
  - title: Hood Missile / usage
    position:
      serializedVersion: 2
      x: -1000
      y: -550
      width: 660
      height: 450
    contents: 'INTERIOR ONLY: wheel-smoke 8x8 alpha/normal flipbook, randomized frames
      and thin AlongVelocity shape. Continuous spawn. Low birth alpha retained per
      particle; smooth onset, late fade; overlapping wisps create density without
      additive light or white-color ramps. Real volume height, weak bounded rise
      and slow curl. Existing moving roof/floor proxies retained. No Burst, no enable
      threshold, no prewarm. Does not change SideOverflow, missile, launch or hood
      motion.'
    theme: Classic
    textSize: Medium
    colorTheme: 0
  categories: []
  uiBounds:
    serializedVersion: 2
    x: 0
    y: 0
    width: 0
    height: 0
