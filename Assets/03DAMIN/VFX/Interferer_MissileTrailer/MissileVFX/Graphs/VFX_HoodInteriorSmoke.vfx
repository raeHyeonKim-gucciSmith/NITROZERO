  stickyNoteInfos:
  - title: Hood Missile / usage
    position:
      serializedVersion: 2
      x: -1000
      y: -550
      width: 660
      height: 450
    contents: 'HOOD INTERIOR / Wheel03 visual treatment: lit 8x8 frames9..57, normal
      bending.35, soft intersection.055, gentle alpha onset and diffuse fade. Continuous
      small puffs overlap in true3D around missiles; birth opacity/fill captured
      in Initialize. No Burst/activation/prewarm, no missile-trail logic. Slow bounded
      turbulence/rise; moving hood and interior floor collisions preserved.'
    theme: Classic
    textSize: Medium
    colorTheme: 0
  categories: []
  uiBounds:
    serializedVersion: 2
    x: 0
    y: 0
