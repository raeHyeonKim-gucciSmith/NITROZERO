  stickyNoteInfos:
  - title: Hood Missile / usage
    position:
      serializedVersion: 2
      x: -1000
      y: -550
      width: 660
      height: 450
    contents: 'SIDE ONLY: original two natural seam systems retain their lifetime,
      fade, continuous distributed sources and stateful Euler curl motion. CINEMATIC
      FINAL adds short grey scattered wisps: .84-1.26s default lifetime, random initial
      velocities, strong drag, weak rise, one smooth appearance/fade envelope. Same
      sequence emission clock. Existing body proxy retained. No Update SetPosition,
      age-based S-path, Burst or enable threshold. Interior, hood, missile and sequence
      timings untouched.'
    theme: Classic
    textSize: Medium
    colorTheme: 0
  categories: []
  uiBounds:
    serializedVersion: 2
    x: 0
    y: 0
    width: 0
    height: 0
