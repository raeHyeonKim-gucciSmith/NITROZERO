  stickyNoteInfos:
  - title: Hood Missile / usage
    position:
      serializedVersion: 2
      x: -1000
      y: -550
      width: 660
      height: 450
    contents: 'SIDE ONLY: two continuous native systems adapted from tire01 Contact
      and tire03 Trailing. Original 8x8 smoke/normal maps, Alpha lit shading, 360deg
      random rotation, frames9..57, relative opacity, contact flattening and age
      growth/fade retained. Wheel positions replaced by seam volume; rear wake replaced
      by short drag-limited outward movement then upward curl. World-up supplied
      in local coordinates. Existing body proxy retained. Emission defaults0 and
      does not change existing particle alpha. No missile trail, Burst, object toggles
      or interior changes.'
    theme: Classic
    textSize: Medium
    colorTheme: 0
  categories: []
  uiBounds:
    serializedVersion: 2
    x: 0
    y: 0
    width: 0
    height: 0
