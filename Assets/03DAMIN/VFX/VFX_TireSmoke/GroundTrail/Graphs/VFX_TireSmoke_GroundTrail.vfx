  stickyNoteInfos:
  - title: 05 GroundTrailSmoke ONLY
    position:
      serializedVersion: 2
      x: 650
      y: 100
      width: 600
      height: 400
    contents: 'Local X = wheel axle. Rear = -Z. Asphalt = Y 0. Continuous low ground
      wake; no orbit and no strong rise.

      Edit exposed EmissionRate / FlowSpeed
      / Lifetime / Opacity / GroundHeight / Spread / Turbulence / SizeMultiplier
      / SmokeColor / ContactWidth.

      Standalone new graph and copied textures.
      Existing 01-04 are untouched. No runtime script. Stationary wheel preview:
      vehicle speed/slip binding is not implemented.'
    theme: Classic
    textSize: Medium
    colorTheme: 0
  categories: []
  uiBounds:
    serializedVersion: 2
    x: 0
    y: 0
    width: 0
    height: 0
